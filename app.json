{
  "expo": {
    "name": "Pulso",
    "slug": "pulso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/azokar-icon.png",
    "scheme": "pulso",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/azokar-icon.png"
    },
    "android": {
      "package": "com.pulso.personal",
      "adaptiveIcon": {
        "backgroundColor": "#080D18",
        "foregroundImage": "./assets/images/azokar-android-foreground.png",
        "monochromeImage": "./assets/images/azokar-android-monochrome.png",
        "backgroundImage": "./assets/images/azokar-android-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/azokar-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080D18",
          "image": "./assets/images/azokar-splash.png",
          "imageWidth": 148
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f4f8d6d8-558a-41ba-8d2d-879c1aa870ab"
      }
    },
    "owner": "azokar"
  }
}
